{
  "manifest_version": 3,
  "name": "Quanta Wallet",
  "version": "1.0.3",
  "description": "Post-Quantum PQC wallet for QuantaChain (QUA) — Falcon-512 signatures, NIST PQC standard. Multi-account HD derivation.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Quanta Wallet",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms"
  ],

  "host_permissions": [
    "https://*.quantachain.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
